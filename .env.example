# Environment variables template
# Copy to .env and fill in real values for local development.
# NOTE: never commit a real .env file. This is a safe template.

# --- Database ---
# SQLite for development and test, PostgreSQL for production.
DATABASE_URL=file:./dev.db

# --- Auth ---
JWT_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- PayMob (online payments, hosted iframe) ---
PAYMOB_API_KEY=change-me
PAYMOB_INTEGRATION_ID=change-me
PAYMOB_HMAC_SECRET=change-me
PAYMOB_IFRAME_ID=change-me
PAYMOB_API_URL=https://accept.paymob.com/api

# --- Frontend (public, safe to expose) ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3001
